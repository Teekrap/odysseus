{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odysseus",
  "version": "0.1.0",
  "identifier": "app.odysseus.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
